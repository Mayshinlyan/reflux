{
  "expo": {
    "name": "a day in my belly",
    "slug": "a-day-in-my-belly",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "adayinmybelly",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.mayshinlyan.adayinmybelly",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mayshinlyan.adayinmybelly",
      "adaptiveIcon": {
        "backgroundColor": "#FAF1DE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9EFD9",
          "image": "./assets/images/splash-image.png",
          "imageWidth": 280
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "a day in my belly uses the camera to photograph your meals.",
          "photosPermission": "a day in my belly reads a meal photo you choose.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "FoodWidget",
              "displayName": "Snap food",
              "description": "Snap a meal, or log one of your saved foods, in one tap.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ],
      "expo-asset",
      "@sentry/react-native"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#FAF1DE",
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.mayshinlyan.adayinmybelly.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.mayshinlyan.adayinmybelly"]
                  }
                }
              ]
            }
          }
        },
        "projectId": "c05e6643-cc1c-4bbd-8010-501e31dac826"
      }
    },
    "owner": "lotusmaycreates"
  }
}
